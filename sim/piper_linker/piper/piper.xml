<!-- ============================================================
  Piper 标准版 6 轴臂 + 灵巧手连接件 + 左 Linker Hand O6-CAN
  数据来源:
    · 臂部结构      ← AgileX 官方 piper.xml (agx_arm_sim)
    · 连接件        ← 灵巧手连接件.STEP (用户提供的 CAD)
    · 手部          ← linkerhand-urdf/O6/left/linkerhand_o6_left.urdf
  手部通过 Ø39mm 同轴连接件(厚 17.5mm)安装在 link6 法兰上。
  修改/溯源记录见同目录 ../PROVENANCE.md
============================================================ -->
<mujoco model="piper_description">
  <!-- 网格目录 = 本文件所在目录 (piper/) -->
  <compiler angle="radian" meshdir="."/>

  <!-- 官方参数: implicitfast 积分器(对位置伺服更稳) + 椭圆摩擦锥(配合等式约束更稳) -->
  <option integrator="implicitfast" cone="elliptic" impratio="10"/>

  <!-- 默认类:
       piper    臂部关节基类 (摩擦/转子惯量/位置执行器力限)
       finger   (原两指夹爪遗留, 已无用, 保留不影响)
       visual   外观网格: group2 可见, 不参与碰撞, 密度0
       collision 碰撞体: group3 默认隐藏, 胶囊代理 (臂部官方设计;
                 手部需显式加 type="mesh" 才能用网格碰撞, 否则退化成胶囊) -->
  <default>
    <default class="piper">
      <joint frictionloss="0.3" armature="0.005"/>
      <position inheritrange="1" forcerange="-100 100"/>
      <default class="finger">
        <joint frictionloss="0" type="slide"/>
        <position forcerange="-10 10"/>
      </default>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0" density="0"/>
      </default>
      <default class="collision">
        <geom group="3" type="capsule"/>
      </default>
    </default>
  </default>

  <!-- 材质: 全部来自官方 piper.xml, 未修改 -->
